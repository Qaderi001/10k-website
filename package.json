{
  "name": "magie-studio-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:content && npm run build:3d",
    "build:content": "node scripts/build-showcases.mjs",
    "build:3d": "esbuild src/fence3d.js --bundle --minify --format=esm --target=es2020 --legal-comments=eof --outfile=assets/js/fence3d.min.js",
    "check": "node scripts/build-showcases.mjs --check"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "0.160.0"
  }
}
